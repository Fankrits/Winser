<Window
  x:Class="Winser.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="using:Winser"
  xmlns:views="using:Winser.Views"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <!--
    Disabled from 29d266f to c66e231 while chasing a WebView2 rendering bug: on at least one
    real (non-VM) machine, WebView2 rendered nothing at all - not even the New Tab page - and
    no amount of resizing or switching tabs recovered it. That symptom is now explained without
    Mica - f69ce7d and ffa2811 each fixed a way the browser element could be created against a
    collapsed or zero-size container, which is exactly "blank, and permanently so" - so Mica was
    never actually the culprit, just a variable removed at the same time by coincidence of
    timing. Restored now that the real cause (TabView's default VerticalAlignment="Top", fixed
    in c66e231) is confirmed on a real machine. If it turns out to still conflict with WebView2
    on some hardware, revert this one commit - nothing else depends on it being on.
  -->
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!--
    Transparent, not unset: lets Mica show through while keeping the whole window hit-testable.

    One cell, no columns and no rows: the page fills the window edge to edge in both modes. An
    earlier vertical-tabs layout reserved a left column - first tracking the pane's full width so
    the page shifted aside when it opened, later just the hover-zone width - and either way that
    column was visible as a band of window background down the left of every page. Nothing
    reserves space for vertical tabs now: the expanded pane is a windowed Popup that floats over
    the page, and the hover trigger is the cursor's own position rather than an element needing
    room to sit in (see MainWindow.xaml.cs).

    TabStrip deliberately has no Grid.Row either - it must stay anchored at y=0 in both modes,
    since that is what lets a negative top margin (see MainWindow.xaml.cs, UpdateChromeLayout)
    push the native strip fully off-screen above the window rather than just far enough to clear a
    reserved row; the vertical mode drag region is a same-origin overlay, not a second row, for
    the same y=0 reason - see its own comment below.
  -->
  <Grid x:Name="RootGrid" Background="Transparent">

    <!--
      VerticalAlignment is load-bearing, not cosmetic. TabView's own default style sets
      VerticalAlignment="Top" (DefaultTabViewStyle, microsoft-ui-xaml
      controls/dev/TabView/TabView.xaml), which suits a tab strip pinned above something else
      but is wrong for a browser, where the tab *is* the window. Left at the default, TabView
      is arranged at its desired height rather than the window's: its template's star row
      hands the selected page an unconstrained height, BrowserTabPage's own star row collapses
      to whatever its content happens to want, and the WebView2 - faithfully filling a
      container that is itself wrong - paints the page into a band a few dozen pixels tall,
      full width. Overriding it here is the whole fix; nothing further down the tree can
      recover a height its ancestor never asked for.
    -->
    <TabView
      x:Name="TabStrip"
      CanDragTabs="True"
      CanReorderTabs="True"
      IsAddTabButtonVisible="True"
      SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
      TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
      TabWidthMode="Equal"
      VerticalAlignment="Stretch"
      AddTabButtonClick="OnAddTabButtonClick"
      TabCloseRequested="OnTabCloseRequested">

      <!--  Left of the tabs: app mark, plus an InPrivate badge when this window is private.  -->
      <TabView.TabStripHeader>
        <StackPanel
          x:Name="TabStripHeaderPanel"
          Orientation="Horizontal"
          Padding="10,0,6,0"
          Spacing="8"
          VerticalAlignment="Center">
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="PrivateBadge"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate" />
          </Border>
        </StackPanel>
      </TabView.TabStripHeader>

      <!--  Right of the tabs: the window drag region. MinWidth keeps tabs clear of the caption buttons.  -->
      <TabView.TabStripFooter>
        <Grid
          x:Name="CustomDragRegion"
          Background="Transparent"
          MinWidth="188" />
      </TabView.TabStripFooter>

      <TabView.TabItemTemplate>
        <DataTemplate x:DataType="vm:BrowserTabViewModel">
          <!--
            No content alignment set here on purpose. TabViewItem's Horizontal/
            VerticalContentAlignment drive the *header* presenter in its own template - the
            title inside the tab chrome - and never reach Content, which TabView renders
            itself. Setting them to Stretch was tried against the band-height bug and only
            skewed the tab titles; the fix is TabView's VerticalAlignment above.
          -->
          <TabViewItem
            Header="{x:Bind Title, Mode=OneWay}"
            IconSource="{x:Bind TabIcon, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">

            <TabViewItem.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
              </MenuFlyout>
            </TabViewItem.ContextFlyout>

            <TabViewItem.Content>
              <views:BrowserTabPage ViewModel="{x:Bind}" />
            </TabViewItem.Content>
          </TabViewItem>
        </DataTemplate>
      </TabView.TabItemTemplate>
    </TabView>

    <!--
      Vertical tabs mode's stand-in for TabStripFooter: the bar the caption buttons come back on,
      and the window's drag region, since TabStrip's own footer is inside its (now hidden) strip.

      Fully there or fully gone, never a transparent layer over the site. At rest its Height is 0
      - no tint, no buttons, no drag region - so the page runs to the top of the window and its
      top edge takes clicks like the rest of it. When the pointer reaches the top-right corner,
      MainWindow.UpdateVerticalCaptionBar gives it its height back and pushes the page down by
      the same amount, so the bar has a row of its own rather than covering the top of the page.

      Still Top-aligned in RootGrid's one cell rather than a Grid row of its own: TabStrip has
      to stay anchored at y=0 for the strip-hiding trick (see UpdatePageInset), so the room for
      the bar is made by the page's top margin instead.
    -->
    <Grid
      x:Name="VerticalModeDragRegion"
      VerticalAlignment="Top"
      Background="Transparent"
      Visibility="{x:Bind ViewModel.VerticalTabsPaneVisibility, Mode=OneWay}">

      <!--
        The tint is a child rather than this Grid's own Background so the Grid itself can stay
        the element handed to SetTitleBar in both states - only its height changes. Transparent
        rather than unset on the Grid for the usual reason - an unset Background is not
        hit-testable, and this one has to be while the bar is out.

        Opacity is driven from MainWindow.ApplyCaptionReveal, along with the caption buttons
        this bar exists to make room for: page-first at rest, chrome when the pointer goes
        looking for it.
      -->
      <Border x:Name="TopChromeTint" Background="{ThemeResource WinserChromeBrush}" Opacity="0">
        <Border.OpacityTransition>
          <ScalarTransition Duration="0:0:0.12" />
        </Border.OpacityTransition>
      </Border>
    </Grid>

    <!--
      Vertical tabs mode's stand-in for the whole native strip.

      There is deliberately no hover strip element here any more, and RootGrid has no columns: the
      page fills the window edge to edge, with nothing reserving a band down the left for the
      pointer to land on. A strip would have had to stay clear of WebView2 to receive
      PointerEntered at all, and that reserved band was visible as a sliver of window background
      beside every page. So the hover trigger is the cursor's own position instead, polled in
      MainWindow.xaml.cs - which no element can swallow, needs no screen space, and leaves the
      leftmost pixels of the page clickable rather than covered by an invisible catcher.

      ShouldConstrainToRootBounds="False" makes this a windowed popup, which gets its own HWND and
      so renders above WebView2's, escaping the airspace problem that made a plain inline overlay
      invisible over a live page. Unlike the owned top-level Window this used to be, a Popup has no
      window frame for DWM to draw a border around - which is what the white outline was, through
      three failed attempts to suppress it at the window level. Rounded corners and theme are
      ordinary XAML here rather than DWM attributes and manual propagation.

      Known trade, and the reason this route was passed over the first time: drag-and-drop inside
      a windowed popup is broken by microsoft-ui-xaml#9276, so reordering tabs by dragging them
      within the pane may not work. That issue predates the WinAppSDK 2.3 this project builds
      against; if it still reproduces, reordering is the thing to give up, not the floating.

      IsOpen is driven from code, not bound: the card slides and fades in after the popup opens,
      and out before it closes (MainWindow.UpdateVerticalTabsPane). A binding would close the
      popup the instant the view model said so, cutting the exit animation off before its first
      frame. VerticalTabsHost is there only to clip: the card travels by its own width to get
      off-screen, and without a clip it would be drawn out past the window's left edge, over the
      desktop, on a window that is not maximized.
    -->
    <Popup x:Name="VerticalTabsFlyout" ShouldConstrainToRootBounds="False">
      <Grid x:Name="VerticalTabsHost">
      <Border
        x:Name="VerticalTabsCard"
        Background="{ThemeResource WinserPaneBrush}"
        CornerRadius="8"
        PointerEntered="OnVerticalTabsPanePointerEntered">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: app mark, InPrivate badge, and the pin toggle - the pane's own stand-in for
              TabStripHeader/TabStripFooter in horizontal mode.  -->
        <Grid
          Grid.Row="0"
          Height="40"
          Padding="12,0,8,0"
          ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="VerticalPrivateBadge"
            Grid.Column="1"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate" />
          </Border>
          <Button
            Grid.Column="3"
            AutomationProperties.Name="{x:Bind ViewModel.PinTooltip, Mode=OneWay}"
            Command="{x:Bind ViewModel.ToggleVerticalTabsPinnedCommand}"
            Content="{x:Bind ViewModel.PinGlyph, Mode=OneWay}"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}" />
        </Grid>

        <!--  Everything BrowserTabPage's own toolbar carries (hidden while vertical tabs is on,
              see BrowserViewModel.IsToolbarVisible): back, forward, reload and home on the left;
              bookmark, mute and zoom on the right. All act on whichever tab is selected, so every
              binding here is explicitly OneWay: SelectedTab changes as the user switches tabs,
              unlike BrowserTabPage's own ViewModel, which is fixed to one tab for that page's
              whole lifetime. Mute and zoom only take room while they apply.  -->
        <Grid
          Grid.Row="1"
          Margin="8,0,8,0"
          ColumnSpacing="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button
            Grid.Column="0"
            AutomationProperties.Name="Back"
            Command="{x:Bind ViewModel.SelectedTab.GoBackCommand, Mode=OneWay}"
            Content="&#xE72B;"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="Back (Alt+Left)" />
          <Button
            Grid.Column="1"
            AutomationProperties.Name="Forward"
            Command="{x:Bind ViewModel.SelectedTab.GoForwardCommand, Mode=OneWay}"
            Content="&#xE72A;"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="Forward (Alt+Right)" />
          <Button
            Grid.Column="2"
            AutomationProperties.Name="Reload"
            Command="{x:Bind ViewModel.SelectedTab.ReloadOrStopCommand, Mode=OneWay}"
            Content="{x:Bind ViewModel.SelectedTab.ReloadGlyph, Mode=OneWay}"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTab.ReloadTooltip, Mode=OneWay}" />
          <Button
            Grid.Column="3"
            AutomationProperties.Name="Home"
            Command="{x:Bind ViewModel.SelectedTab.GoHomeCommand, Mode=OneWay}"
            Content="&#xE80F;"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="Home (Alt+Home)" />

          <Button
            Grid.Column="5"
            AutomationProperties.Name="Zoom level"
            Command="{x:Bind ViewModel.SelectedTab.ResetZoomCommand, Mode=OneWay}"
            Content="{x:Bind ViewModel.SelectedTab.ZoomLabel, Mode=OneWay}"
            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
            FontSize="12"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="Reset zoom to 100% (Ctrl+0)"
            Visibility="{x:Bind local:MainWindow.Show(ViewModel.SelectedTab.IsZoomed), Mode=OneWay}"
            Width="44" />
          <Button
            Grid.Column="6"
            AutomationProperties.Name="{x:Bind ViewModel.SelectedTab.MuteTooltip, Mode=OneWay}"
            Command="{x:Bind ViewModel.SelectedTab.ToggleMuteCommand, Mode=OneWay}"
            Content="{x:Bind ViewModel.SelectedTab.MuteGlyph, Mode=OneWay}"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTab.MuteTooltip, Mode=OneWay}"
            Visibility="{x:Bind local:MainWindow.Show(ViewModel.SelectedTab.IsAudioPlaying), Mode=OneWay}" />
          <Button
            Grid.Column="7"
            AutomationProperties.Name="{x:Bind ViewModel.SelectedTab.BookmarkTooltip, Mode=OneWay}"
            Command="{x:Bind ViewModel.SelectedTab.ToggleBookmarkCommand, Mode=OneWay}"
            Content="{x:Bind ViewModel.SelectedTab.BookmarkGlyph, Mode=OneWay}"
            Style="{StaticResource SidebarIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTab.BookmarkTooltip, Mode=OneWay}" />
        </Grid>

        <AutoSuggestBox
          x:Name="VerticalAddressBox"
          Grid.Row="2"
          Height="32"
          Margin="8,4"
          CornerRadius="16"
          ItemsSource="{x:Bind ViewModel.SelectedTab.Suggestions, Mode=OneWay}"
          PlaceholderText="Search or enter web address"
          Text="{x:Bind ViewModel.SelectedTab.AddressText, Mode=OneWay}"
          TextMemberPath="Text"
          GotFocus="OnVerticalAddressGotFocus"
          LostFocus="OnVerticalAddressLostFocus"
          QuerySubmitted="OnVerticalAddressQuerySubmitted"
          TextChanged="OnVerticalAddressTextChanged">
          <AutoSuggestBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AddressSuggestion">
              <Grid Padding="0,3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                  FontSize="14"
                  Glyph="{x:Bind Glyph}"
                  Opacity="0.65"
                  VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Description}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <!--  Same 36px row height and icon column as a tab, so it lines up with the list below.  -->
        <Button
          Grid.Row="3"
          Height="36"
          Margin="8,2,8,4"
          Padding="10,0"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left"
          Background="Transparent"
          BorderThickness="0"
          Command="{x:Bind ViewModel.AddTabCommand}"
          CornerRadius="8"
          ToolTipService.ToolTip="New tab (Ctrl+T)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon
              Width="16"
              FontSize="14"
              Glyph="&#xE710;"
              Opacity="0.85" />
            <TextBlock Text="New tab" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <ListView
          x:Name="VerticalTabList"
          Grid.Row="4"
          Padding="6,0,6,6"
          AllowDrop="True"
          CanReorderItems="True"
          ItemContainerStyle="{StaticResource VerticalTabItemStyle}"
          ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
          SelectionChanged="OnVerticalTabSelectionChanged"
          SelectionMode="Single">
          <!--
            A soft translucent pill for the selected row instead of ListViewItem's default
            accent-colored left bar, scoped to just this list (winser://settings' own sidebar
            keeps the default look). Set here rather than through VerticalTabItemStyle because
            Resources is not a DependencyProperty, so a Style Setter cannot target it (WMC0095).
            Nested ThemeDictionaries rather than a StaticResource alias to a shared brush:
            StaticResource resolves once at parse time and would freeze the pill to whichever
            theme was active then, where ThemeResource - what ListViewItem's own template uses
            to read these keys - re-resolves on every theme change.
          -->
          <ListView.Resources>
            <ResourceDictionary>
              <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFFFFF" Opacity="0.85" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFFFFF" Opacity="0.95" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFFFFF" Opacity="0.95" />
                  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFFFFF" Opacity="0.2" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFFFFF" Opacity="0.28" />
                  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFFFFF" Opacity="0.28" />
                  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                  <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                </ResourceDictionary>
                <!--  No HighContrast entry on purpose: ThemeResource keeps walking outward to the
                      framework's own defaults for a theme this dictionary doesn't cover, which
                      already satisfy high-contrast's contrast rules - a translucent pill would not.  -->
              </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
          </ListView.Resources>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:BrowserTabViewModel">
              <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                    <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                    <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
                  </MenuFlyout>
                </Grid.ContextFlyout>

                <!--
                  A 20px slot holding a 16px icon, with a ring round it while the tab loads: the
                  sidebar's stand-in for the progress bar the page no longer has above it in this
                  mode. The favicon is an Image pinned to 16x16 with Stretch=Uniform rather than an
                  IconSourceElement - that one hands an ImageIconSource its bitmap's natural size,
                  so a 32px or 64px favicon spilled out of the row. Tabs without a favicon (and the
                  native pages) get a FontIcon instead; the view model says which via ShowsFavicon.
                  IsActive on the ring rather than Visibility, so an idle ring animates nothing.
                -->
                <Grid Width="20" Height="20" VerticalAlignment="Center">
                  <Image
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    Source="{x:Bind FaviconImage, Mode=OneWay}"
                    Stretch="Uniform"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind local:MainWindow.Show(ShowsFavicon), Mode=OneWay}" />
                  <FontIcon
                    FontSize="14"
                    Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind local:MainWindow.Hide(ShowsFavicon), Mode=OneWay}" />
                  <ProgressRing
                    Width="20"
                    Height="20"
                    MinWidth="0"
                    MinHeight="0"
                    IsActive="{x:Bind IsLoading, Mode=OneWay}"
                    IsIndeterminate="True" />
                </Grid>
                <TextBlock
                  Grid.Column="1"
                  Text="{x:Bind Title, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis"
                  VerticalAlignment="Center" />
                <Button
                  Grid.Column="2"
                  AutomationProperties.Name="Close tab"
                  Command="{x:Bind CloseCommand}"
                  Content="&#xE711;"
                  Style="{StaticResource SidebarTabCloseButtonStyle}"
                  ToolTipService.ToolTip="Close tab" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!--
          Footer: downloads bottom-left, the menu bottom-right - the two things the horizontal
          toolbar keeps at its far end. Both open upward and rightward so they land over the page
          rather than off the bottom or left of the window. Their flyouts are popups of their own,
          which MainWindow.HasOpenPaneMenu already counts, so an auto-hidden pane stays out while
          either is open.
        -->
        <Border
          Grid.Row="5"
          Padding="8,6"
          BorderBrush="{ThemeResource WinserChromeBorderBrush}"
          BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Button
                AutomationProperties.Name="Downloads"
                Content="&#xE896;"
                Style="{StaticResource SidebarIconButtonStyle}"
                ToolTipService.ToolTip="Downloads (Ctrl+J)">
                <Button.Flyout>
                  <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel Width="340" Spacing="8">
                      <Grid>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Downloads" />
                        <HyperlinkButton
                          Padding="4,0"
                          Command="{x:Bind ViewModel.OpenDownloadsCommand}"
                          Content="See all"
                          HorizontalAlignment="Right" />
                      </Grid>
                      <TextBlock
                        Opacity="0.6"
                        Text="Nothing downloaded yet."
                        Visibility="{x:Bind local:MainWindow.ShowIfEmpty(ViewModel.Downloads.Items.Count), Mode=OneWay}" />
                      <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Downloads.Items, Mode=OneWay}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DownloadItem">
                              <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                  <ProgressBar
                                    Maximum="100"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                    Visibility="{x:Bind local:MainWindow.Show(IsInProgress), Mode=OneWay}" />
                                  <TextBlock
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                                </StackPanel>
                                <Button
                                  Grid.Column="1"
                                  AutomationProperties.Name="Open file"
                                  Command="{x:Bind OpenCommand}"
                                  Content="&#xE8E5;"
                                  Style="{StaticResource SidebarIconButtonStyle}"
                                  ToolTipService.ToolTip="Open file"
                                  VerticalAlignment="Top" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <!--  The dot that says a download is in flight, as on the horizontal toolbar.  -->
              <Ellipse
                Width="7"
                Height="7"
                Margin="0,5,4,0"
                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                HorizontalAlignment="Right"
                IsHitTestVisible="False"
                VerticalAlignment="Top"
                Visibility="{x:Bind local:MainWindow.Show(ViewModel.HasActiveDownloads), Mode=OneWay}" />
            </Grid>

            <Button
              Grid.Column="2"
              AutomationProperties.Name="Settings and more"
              Content="&#xE712;"
              Style="{StaticResource SidebarIconButtonStyle}"
              ToolTipService.ToolTip="Settings and more">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedLeft">
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.AddTabCommand}"
