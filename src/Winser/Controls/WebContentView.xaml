<UserControl
  x:Class="Winser.Controls.WebContentView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <!--
    Deliberately empty: the WebView2 element itself is created and added in code-behind, not
    declared here. Discarding an idle tab's renderer means calling WebView2.Close() on it, which
    leaves that specific instance permanently unusable - the only way to show content in this
    tab again is a brand new WebView2 element, which a XAML-declared, x:Name-bound one cannot be
    replaced with. See WebContentView.xaml.cs's CreateBrowserElement/Release.
  -->
  <Grid x:Name="ContentGrid" Background="{ThemeResource WinserContentBackgroundBrush}" />
</UserControl>
