<Window
  x:Class="Winser.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="using:Winser.Views"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <!--
    Disabled from 29d266f to c66e231 while chasing a WebView2 rendering bug: on at least one
    real (non-VM) machine, WebView2 rendered nothing at all - not even the New Tab page - and
    no amount of resizing or switching tabs recovered it. That symptom is now explained without
    Mica - f69ce7d and ffa2811 each fixed a way the browser element could be created against a
    collapsed or zero-size container, which is exactly "blank, and permanently so" - so Mica was
    never actually the culprit, just a variable removed at the same time by coincidence of
    timing. Restored now that the real cause (TabView's default VerticalAlignment="Top", fixed
    in c66e231) is confirmed on a real machine. If it turns out to still conflict with WebView2
    on some hardware, revert this one commit - nothing else depends on it being on.
  -->
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!-- Transparent, not unset: lets Mica show through while keeping the whole window hit-testable. -->
  <Grid x:Name="RootGrid" Background="Transparent">

    <!--
      VerticalAlignment is load-bearing, not cosmetic. TabView's own default style sets
      VerticalAlignment="Top" (DefaultTabViewStyle, microsoft-ui-xaml
      controls/dev/TabView/TabView.xaml), which suits a tab strip pinned above something else
      but is wrong for a browser, where the tab *is* the window. Left at the default, TabView
      is arranged at its desired height rather than the window's: its template's star row
      hands the selected page an unconstrained height, BrowserTabPage's own star row collapses
      to whatever its content happens to want, and the WebView2 - faithfully filling a
      container that is itself wrong - paints the page into a band a few dozen pixels tall,
      full width. Overriding it here is the whole fix; nothing further down the tree can
      recover a height its ancestor never asked for.
    -->
    <TabView
      x:Name="TabStrip"
      CanDragTabs="True"
      CanReorderTabs="True"
      IsAddTabButtonVisible="True"
      SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
      TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
      TabWidthMode="Equal"
      VerticalAlignment="Stretch"
      AddTabButtonClick="OnAddTabButtonClick"
      TabCloseRequested="OnTabCloseRequested">

      <!--  Left of the tabs: app mark, plus an InPrivate badge when this window is private.  -->
      <TabView.TabStripHeader>
        <StackPanel
          x:Name="TabStripHeaderPanel"
          Orientation="Horizontal"
          Padding="10,0,6,0"
          Spacing="8"
          VerticalAlignment="Center">
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="PrivateBadge"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate" />
          </Border>
        </StackPanel>
      </TabView.TabStripHeader>

      <!--  Right of the tabs: the window drag region. MinWidth keeps tabs clear of the caption buttons.  -->
      <TabView.TabStripFooter>
        <Grid
          x:Name="CustomDragRegion"
          Background="Transparent"
          MinWidth="188" />
      </TabView.TabStripFooter>

      <TabView.TabItemTemplate>
        <DataTemplate x:DataType="vm:BrowserTabViewModel">
          <!--
            No content alignment set here on purpose. TabViewItem's Horizontal/
            VerticalContentAlignment drive the *header* presenter in its own template - the
            title inside the tab chrome - and never reach Content, which TabView renders
            itself. Setting them to Stretch was tried against the band-height bug and only
            skewed the tab titles; the fix is TabView's VerticalAlignment above.
          -->
          <TabViewItem
            Header="{x:Bind Title, Mode=OneWay}"
            IconSource="{x:Bind TabIcon, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">

            <TabViewItem.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
              </MenuFlyout>
            </TabViewItem.ContextFlyout>

            <TabViewItem.Content>
              <views:BrowserTabPage ViewModel="{x:Bind}" />
            </TabViewItem.Content>
          </TabViewItem>
        </DataTemplate>
      </TabView.TabItemTemplate>
    </TabView>

  </Grid>
</Window>
