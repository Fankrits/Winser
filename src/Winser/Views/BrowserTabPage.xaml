<UserControl
  x:Class="Winser.Views.BrowserTabPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Winser.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:models="using:Winser.Models"
  xmlns:views="using:Winser.Views"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  ============================== toolbar ==============================  -->
    <Grid
      Grid.Row="0"
      Height="44"
      Padding="6,0"
      Background="{ThemeResource WinserChromeBrush}"
      ColumnSpacing="2"
      Visibility="{x:Bind ViewModel.Shell.IsToolbarVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button
        Grid.Column="0"
        AutomationProperties.Name="Back"
        Command="{x:Bind ViewModel.GoBackCommand}"
        Content="&#xE72B;"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="Back (Alt+Left)" />

      <Button
        Grid.Column="1"
        AutomationProperties.Name="Forward"
        Command="{x:Bind ViewModel.GoForwardCommand}"
        Content="&#xE72A;"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="Forward (Alt+Right)" />

      <Button
        Grid.Column="2"
        AutomationProperties.Name="Reload"
        Command="{x:Bind ViewModel.ReloadOrStopCommand}"
        Content="{x:Bind ViewModel.ReloadGlyph, Mode=OneWay}"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="{x:Bind ViewModel.ReloadTooltip, Mode=OneWay}" />

      <Button
        Grid.Column="3"
        AutomationProperties.Name="Home"
        Command="{x:Bind ViewModel.GoHomeCommand}"
        Content="&#xE80F;"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="Home (Alt+Home)" />

      <!--  Connection state, with the details behind a click like every other browser.  -->
      <Button
        Grid.Column="4"
        Margin="6,0,0,0"
        AutomationProperties.Name="Site information"
        Content="{x:Bind ViewModel.SecurityGlyph, Mode=OneWay}"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="{x:Bind ViewModel.SecurityTooltip, Mode=OneWay}">
        <Button.Flyout>
          <Flyout>
            <StackPanel MaxWidth="320" Spacing="6">
              <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.HostLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock
                Opacity="0.8"
                Text="{x:Bind ViewModel.SecurityTooltip, Mode=OneWay}"
                TextWrapping="Wrap" />
              <TextBlock
                FontFamily="Consolas"
                FontSize="12"
                Opacity="0.6"
                Text="{x:Bind ViewModel.Url, Mode=OneWay}"
                TextWrapping="Wrap" />
              <Button
                Margin="0,4,0,0"
                Command="{x:Bind ViewModel.CopyLinkCommand}"
                Content="Copy address" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <AutoSuggestBox
        x:Name="AddressBox"
        Grid.Column="5"
        Height="32"
        Margin="4,0"
        VerticalAlignment="Center"
        CornerRadius="16"
        ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
        PlaceholderText="Search or enter web address"
        Text="{x:Bind ViewModel.AddressText, Mode=OneWay}"
        TextMemberPath="Text"
        GotFocus="OnAddressGotFocus"
        LostFocus="OnAddressLostFocus"
        QuerySubmitted="OnAddressQuerySubmitted"
        TextChanged="OnAddressTextChanged">
        <AutoSuggestBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AddressSuggestion">
            <Grid Padding="0,3" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon
                FontSize="14"
                Glyph="{x:Bind Glyph}"
                Opacity="0.65"
                VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                  Opacity="0.6"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="{x:Bind Description}"
                  TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </AutoSuggestBox.ItemTemplate>
      </AutoSuggestBox>

      <Button
        Grid.Column="6"
        AutomationProperties.Name="Zoom level"
        Command="{x:Bind ViewModel.ResetZoomCommand}"
        Content="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
        FontFamily="{ThemeResource ContentControlThemeFontFamily}"
        FontSize="12"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="Reset zoom to 100% (Ctrl+0)"
        Visibility="{x:Bind ViewModel.IsZoomed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
        Width="46" />

      <Button
        Grid.Column="7"
        AutomationProperties.Name="{x:Bind ViewModel.MuteTooltip, Mode=OneWay}"
        Command="{x:Bind ViewModel.ToggleMuteCommand}"
        Content="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="{x:Bind ViewModel.MuteTooltip, Mode=OneWay}"
        Visibility="{x:Bind ViewModel.IsAudioPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

      <Button
        Grid.Column="8"
        AutomationProperties.Name="{x:Bind ViewModel.BookmarkTooltip, Mode=OneWay}"
        Command="{x:Bind ViewModel.ToggleBookmarkCommand}"
        Content="{x:Bind ViewModel.BookmarkGlyph, Mode=OneWay}"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="{x:Bind ViewModel.BookmarkTooltip, Mode=OneWay}" />

      <Grid Grid.Column="9">
      <Button
        AutomationProperties.Name="Downloads"
        Content="&#xE896;"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="Downloads (Ctrl+J)">
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Width="380" Spacing="8">
              <Grid>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Downloads" />
                <HyperlinkButton
                  Padding="4,0"
                  Command="{x:Bind ViewModel.Shell.OpenDownloadsCommand}"
                  Content="See all"
                  HorizontalAlignment="Right" />
              </Grid>
              <TextBlock
                Opacity="0.6"
                Text="Nothing downloaded yet."
                Visibility="{x:Bind ViewModel.Shell.Downloads.Items.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" />
              <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{x:Bind ViewModel.Shell.Downloads.Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DownloadItem">
                    <Grid Padding="0,6" ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                          Maximum="100"
                          IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                          Value="{x:Bind ProgressPercent, Mode=OneWay}"
                          Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                          Opacity="0.6"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Text="{x:Bind StatusText, Mode=OneWay}" />
                      </StackPanel>
                      <Button
                        Grid.Column="1"
                        Command="{x:Bind OpenCommand}"
                        Content="&#xE8E5;"
                        Style="{StaticResource ToolbarIconButtonStyle}"
                        ToolTipService.ToolTip="Open file"
                        VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
        <Ellipse
          Width="7"
          Height="7"
          Margin="0,5,4,0"
          Fill="{ThemeResource AccentFillColorDefaultBrush}"
          HorizontalAlignment="Right"
          IsHitTestVisible="False"
          VerticalAlignment="Top"
          Visibility="{x:Bind ViewModel.Shell.HasActiveDownloads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
      </Grid>

      <Button
        Grid.Column="10"
        AutomationProperties.Name="Settings and more"
        Content="&#xE712;"
        Style="{StaticResource ToolbarIconButtonStyle}"
        ToolTipService.ToolTip="Settings and more">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.AddTabCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+T"
              Text="New tab">
              <MenuFlyoutItem.Icon>
                <FontIcon Glyph="&#xE710;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.NewWindowCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+N"
              Text="New window" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.NewPrivateWindowCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+Shift+N"
              Text="New InPrivate window">
              <MenuFlyoutItem.Icon>
                <FontIcon Glyph="&#xE727;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
              Command="{x:Bind ViewModel.ZoomInCommand}"
              KeyboardAcceleratorTextOverride="Ctrl++"
              Text="Zoom in" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.ZoomOutCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+-"
              Text="Zoom out" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.ResetZoomCommand}"
              Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.ToggleFullScreenCommand}"
              KeyboardAcceleratorTextOverride="F11"
              Text="Full screen" />

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
              Command="{x:Bind ViewModel.OpenFindCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+F"
              Text="Find on page" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.PrintCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+P"
              Text="Print" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.CopyLinkCommand}"
              Text="Copy page address" />

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.OpenBookmarksCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+Shift+O"
              Text="Bookmarks" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.OpenHistoryCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+H"
              Text="History" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.OpenDownloadsCommand}"
              KeyboardAcceleratorTextOverride="Ctrl+J"
              Text="Downloads" />
            <ToggleMenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.ToggleBookmarksBarCommand}"
              IsChecked="{x:Bind ViewModel.Shell.ShowBookmarksBar, Mode=OneWay}"
              KeyboardAcceleratorTextOverride="Ctrl+Shift+B"
              Text="Show bookmarks bar" />

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
              Command="{x:Bind ViewModel.OpenDevToolsCommand}"
              KeyboardAcceleratorTextOverride="F12"
              Text="Developer tools" />
            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.OpenSettingsCommand}"
              Text="Settings">
              <MenuFlyoutItem.Icon>
                <FontIcon Glyph="&#xE713;" />
              </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
              Command="{x:Bind ViewModel.Shell.CloseWindowCommand}"
              Text="Close window" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!--  =========================== bookmarks bar ===========================  -->
    <!--
      x:Load rather than Visibility, and the difference is per tab rather than per window. This
      Border is inside TabView's item template, so there is one of it for every open tab, and
      the two ItemsControls below it do not virtualize - a collapsed bookmarks bar was still
      building a Button per bookmark, per tab, and holding them for as long as the tab lived.
      Twenty tabs and thirty bookmarks is six hundred button visual trees for one window's worth
      of bookmarks bar. Deferred, a tab that never shows one never builds one, and turning the
      bar off in settings genuinely reclaims them rather than only hiding them.

      Safe against the null-ViewModel evaluation that made x:Load the wrong choice for
      WebContentView below: this Border has nothing to initialise wrongly and no code-behind
      reference to go null, so the worst a false first pass does is defer the load until
      Bindings.Update() runs - which is exactly what the native panes below already rely on.
    -->
    <Border
      x:Name="BookmarksBar"
      Grid.Row="1"
      Padding="8,3"
      Background="{ThemeResource WinserChromeBrush}"
      BorderBrush="{ThemeResource WinserChromeBorderBrush}"
      BorderThickness="0,0,0,1"
      x:Load="{x:Bind ViewModel.Shell.IsBookmarksBarVisible, Mode=OneWay}">
      <ScrollViewer
        HorizontalScrollBarVisibility="Hidden"
        HorizontalScrollMode="Auto"
        VerticalScrollBarVisibility="Disabled"
        VerticalScrollMode="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ItemsControl ItemsSource="{x:Bind ViewModel.Shell.BookmarkBarItems, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Bookmark">
                <Button
                  Click="OnBookmarkClick"
                  PointerPressed="OnBookmarkPointerPressed"
                  Style="{StaticResource BookmarkBarButtonStyle}"
                  ToolTipService.ToolTip="{x:Bind Url}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE774;" Opacity="0.7" />
                    <TextBlock MaxWidth="140" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem Click="OnBookmarkOpenInNewTab" Text="Open in new tab" />
                      <MenuFlyoutItem Click="OnBookmarkRemove" Text="Remove" />
                    </MenuFlyout>
                  </Button.ContextFlyout>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{x:Bind ViewModel.Shell.BookmarkBarFolders, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BookmarkFolder">
                <Button Style="{StaticResource BookmarkBarButtonStyle}" ToolTipService.ToolTip="{x:Bind Name}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE8B7;" Opacity="0.7" />
                    <TextBlock MaxWidth="140" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <FontIcon FontSize="10" Glyph="&#xE70D;" Opacity="0.5" />
                  </StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <ItemsControl MinWidth="200" ItemsSource="{x:Bind Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:Bookmark">
                            <Button
                              Background="Transparent"
                              BorderThickness="0"
                              Click="OnBookmarkClick"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="8,6"
                              PointerPressed="OnBookmarkPointerPressed"
                              ToolTipService.ToolTip="{x:Bind Url}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE774;" Opacity="0.7" />
                                <TextBlock MaxWidth="240" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!--  ============================= load state ============================  -->
    <!--
      IsIndeterminate is bound rather than hardcoded true, and that is a power fix rather than
      a tidy-up. An indeterminate ProgressBar runs a continuous composition animation, and
      collapsing it only stops it being drawn - the storyboard keeps running, which keeps the
      compositor waking every frame and holds the display pipeline out of its idle state for
      as long as the tab exists. Bound, the animation is torn down when loading finishes
      instead of merely hidden. Visibility stays: it is what reserves no space in the layout.
    -->
    <ProgressBar
      Grid.Row="2"
      Height="2"
      IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

    <!--  ============================== content ==============================  -->
    <Grid Grid.Row="3">

      <!--
        Deliberately always present and always visible, with no x:Load and no Visibility
        binding. A WebView2 created while collapsed or zero-sized gets a zero-bounds
        controller: it navigates and raises title/favicon events perfectly normally, but never
        composites a single pixel, and it does not recover when shown later. Both of those
        bindings evaluate against a null ViewModel during InitializeComponent, so the control
        was being realized collapsed and initialised in exactly that broken state.
        The native pages below are later siblings with opaque backgrounds, so they cover this
        when a winser:// page is showing - no need to hide it.
      -->
      <controls:WebContentView
        x:Name="WebContent"
        Tab="{x:Bind ViewModel, Mode=OneWay}" />

      <views:SettingsView
        x:Name="SettingsPane"
        x:Load="{x:Bind ViewModel.IsSettings, Mode=OneWay}"
        Tab="{x:Bind ViewModel, Mode=OneWay}" />

      <views:HistoryView
        x:Name="HistoryPane"
        x:Load="{x:Bind ViewModel.IsHistory, Mode=OneWay}"
        Tab="{x:Bind ViewModel, Mode=OneWay}" />

      <views:DownloadsView
        x:Name="DownloadsPane"
        x:Load="{x:Bind ViewModel.IsDownloads, Mode=OneWay}" />

      <views:BookmarksView
        x:Name="BookmarksPane"
        x:Load="{x:Bind ViewModel.IsBookmarks, Mode=OneWay}"
        Tab="{x:Bind ViewModel, Mode=OneWay}" />

      <!--  Failed navigation, shown over the (blank) page.  -->
      <Grid
        x:Name="ErrorPane"
        x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}"
        Background="{ThemeResource WinserContentBackgroundBrush}">
        <StackPanel
          MaxWidth="460"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12">
          <FontIcon
            FontSize="40"
            Glyph="&#xEA39;"
            HorizontalAlignment="Left"
            Opacity="0.55" />
          <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="This page didn't load" />
          <TextBlock
            Opacity="0.85"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
          <TextBlock
            FontFamily="Consolas"
            FontSize="12"
            Opacity="0.55"
            Text="{x:Bind ViewModel.Url, Mode=OneWay}"
            TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
              Command="{x:Bind ViewModel.ReloadOrStopCommand}"
              Content="Try again"
              Style="{StaticResource AccentButtonStyle}" />
            <Button Command="{x:Bind ViewModel.GoHomeCommand}" Content="Go home" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!--  Camera / microphone / location / notifications / clipboard.  -->
      <Border
        x:Name="PermissionBar"
        Margin="0,10,0,0"
        Padding="12,8"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        x:Load="{x:Bind ViewModel.IsPermissionPromptOpen, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <FontIcon FontSize="16" Glyph="&#xE72E;" VerticalAlignment="Center" />
          <TextBlock
            MaxWidth="320"
            Text="{x:Bind ViewModel.PermissionPromptText, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />
          <Button
            Command="{x:Bind ViewModel.DenyPermissionCommand}"
            Content="Block"
            VerticalAlignment="Center" />
          <Button
            Command="{x:Bind ViewModel.AllowPermissionCommand}"
            Content="Allow"
            Style="{StaticResource AccentButtonStyle}"
            VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!--  Find on page.  -->
      <Border
        x:Name="FindBar"
        Margin="0,10,18,0"
        Padding="8,6"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        x:Load="{x:Bind ViewModel.IsFindOpen, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBox
            x:Name="FindBox"
            Width="220"
            KeyDown="OnFindBoxKeyDown"
            PlaceholderText="Find on page"
            Text="{x:Bind ViewModel.FindQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock
            MinWidth="56"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.FindStatus, Mode=OneWay}"
            VerticalAlignment="Center" />
          <ToggleButton
            Content="Aa"
            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
            FontSize="12"
            IsChecked="{x:Bind ViewModel.FindMatchCase, Mode=TwoWay}"
            Style="{StaticResource ToolbarToggleButtonStyle}"
            ToolTipService.ToolTip="Match case" />
          <Button
            Command="{x:Bind ViewModel.FindPreviousCommand}"
            Content="&#xE70E;"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="Previous match (Shift+Enter)" />
          <Button
            Command="{x:Bind ViewModel.FindNextCommand}"
            Content="&#xE70D;"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="Next match (Enter)" />
          <Button
            Command="{x:Bind ViewModel.CloseFindCommand}"
            Content="&#xE711;"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="Close (Esc)" />
        </StackPanel>
      </Border>

      <!--  Link preview, bottom-left, the way browsers have always done it.  -->
      <Border
        x:Name="StatusChip"
        Padding="8,3"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,1,0"
        CornerRadius="4,4,0,0"
        HorizontalAlignment="Left"
        IsHitTestVisible="False"
        MaxWidth="560"
        VerticalAlignment="Bottom"
        x:Load="{x:Bind ViewModel.HasStatusText, Mode=OneWay}">
        <TextBlock
          FontSize="12"
          Opacity="0.85"
          Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
          TextTrimming="CharacterEllipsis" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
