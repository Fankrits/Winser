<UserControl
  x:Class="Winser.Controls.WebContentView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <!--
    Deliberately empty: the WebView2 element itself is created and added in code-behind, not
    declared here. Discarding an idle tab's renderer means calling WebView2.Close() on it, which
    leaves that specific instance permanently unusable - the only way to show content in this
    tab again is a brand new WebView2 element, which a XAML-declared, x:Name-bound one cannot be
    replaced with. See WebContentView.xaml.cs's CreateBrowserElement/Release.
  -->
  <Grid x:Name="ContentGrid" Background="{ThemeResource WinserContentBackgroundBrush}">

    <!--
      Sits underneath the WebView2, which is added to this Grid after it and therefore paints
      over it. That is the whole design: this is only ever readable when the renderer is not
      painting, which is exactly when a flat empty rectangle tells you nothing and a sentence
      telling you which stage it stopped at tells you everything.
    -->
    <TextBlock
      x:Name="RendererStatus"
      HorizontalAlignment="Center"
      MaxWidth="460"
      Opacity="0.55"
      Style="{StaticResource CaptionTextBlockStyle}"
      TextAlignment="Center"
      TextWrapping="Wrap"
      VerticalAlignment="Center" />
  </Grid>
</UserControl>
