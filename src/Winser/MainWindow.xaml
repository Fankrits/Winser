<Window
  x:Class="Winser.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="using:Winser.Views"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <!--
    Temporarily disabled: on at least one real (non-VM) machine, WebView2 rendered nothing
    at all - not even the New Tab page - while Mica was active, and no amount of resizing or
    switching tabs recovered it. Removing Mica is the cleanest single-variable test for a
    known class of Mica/WebView2 compositing conflict. Restore once confirmed innocent, or
    replace with an explicit theme-colored background if it's confirmed guilty.
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  -->

  <!-- Explicit background: without Mica there is nothing else painting behind the tab strip. -->
  <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <TabView
      x:Name="TabStrip"
      CanDragTabs="True"
      CanReorderTabs="True"
      IsAddTabButtonVisible="True"
      SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
      TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
      TabWidthMode="Equal"
      AddTabButtonClick="OnAddTabButtonClick"
      TabCloseRequested="OnTabCloseRequested">

      <!--  Left of the tabs: app mark, plus an InPrivate badge when this window is private.  -->
      <TabView.TabStripHeader>
        <StackPanel
          x:Name="TabStripHeaderPanel"
          Orientation="Horizontal"
          Padding="10,0,6,0"
          Spacing="8"
          VerticalAlignment="Center">
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="PrivateBadge"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate" />
          </Border>
        </StackPanel>
      </TabView.TabStripHeader>

      <!--  Right of the tabs: the window drag region. MinWidth keeps tabs clear of the caption buttons.  -->
      <TabView.TabStripFooter>
        <Grid
          x:Name="CustomDragRegion"
          Background="Transparent"
          MinWidth="188" />
      </TabView.TabStripFooter>

      <TabView.TabItemTemplate>
        <DataTemplate x:DataType="vm:BrowserTabViewModel">
          <!--
            The two alignments are load-bearing, not cosmetic. TabViewItem derives from
            ListViewItem, which aligns its content Top/Left rather than stretching it, so
            without these the page is handed its *desired* height instead of the tab's
            available one - a toolbar and a minimal content row, pinned to the top, with the
            rest of the window empty beneath it. The WebView2 then fills that faithfully and
            the page renders into a band a few dozen pixels tall.
          -->
          <TabViewItem
            Header="{x:Bind Title, Mode=OneWay}"
            HorizontalContentAlignment="Stretch"
            IconSource="{x:Bind TabIcon, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
            VerticalContentAlignment="Stretch">

            <TabViewItem.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
              </MenuFlyout>
            </TabViewItem.ContextFlyout>

            <TabViewItem.Content>
              <views:BrowserTabPage ViewModel="{x:Bind}" />
            </TabViewItem.Content>
          </TabViewItem>
        </DataTemplate>
      </TabView.TabItemTemplate>
    </TabView>

  </Grid>
</Window>
