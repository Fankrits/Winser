<Window
  x:Class="Winser.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="using:Winser.Views"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <!--
    Disabled from 29d266f to c66e231 while chasing a WebView2 rendering bug: on at least one
    real (non-VM) machine, WebView2 rendered nothing at all - not even the New Tab page - and
    no amount of resizing or switching tabs recovered it. That symptom is now explained without
    Mica - f69ce7d and ffa2811 each fixed a way the browser element could be created against a
    collapsed or zero-size container, which is exactly "blank, and permanently so" - so Mica was
    never actually the culprit, just a variable removed at the same time by coincidence of
    timing. Restored now that the real cause (TabView's default VerticalAlignment="Top", fixed
    in c66e231) is confirmed on a real machine. If it turns out to still conflict with WebView2
    on some hardware, revert this one commit - nothing else depends on it being on.
  -->
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!--
    Transparent, not unset: lets Mica show through while keeping the whole window hit-testable.

    Column 0 exists for vertical tabs mode only: a pane on the left standing in for the
    horizontal strip. It is sized to zero and collapses to nothing when vertical tabs are off,
    which is also the default - so nothing here changes horizontal mode's geometry. When vertical
    tabs is on, this column is only ever as wide as the pane's hover zone
    (VerticalTabsHoverZoneWidth) - it never grows, not even while the pane is open, because the
    open pane is a separate top-level window floating above this one rather than anything laid out
    in this Grid (see VerticalTabsPane below, and VerticalTabsOverlayWindow). That is what keeps
    the page from resizing when the pane opens. TabStrip's own Grid.Column never changes between
    modes and it deliberately has no Grid.Row at all - its cell must stay anchored at y=0 in both
    modes, since that is what lets a negative top margin (see MainWindow.xaml.cs,
    UpdateChromeLayout) push the native strip fully off-screen above the window rather than just
    far enough to clear a reserved row; the vertical mode drag region is a same-origin overlay,
    not a second row, for the same y=0 reason - see its own comment below.
  -->
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="VerticalTabsColumnDef" Width="0" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!--
      VerticalAlignment is load-bearing, not cosmetic. TabView's own default style sets
      VerticalAlignment="Top" (DefaultTabViewStyle, microsoft-ui-xaml
      controls/dev/TabView/TabView.xaml), which suits a tab strip pinned above something else
      but is wrong for a browser, where the tab *is* the window. Left at the default, TabView
      is arranged at its desired height rather than the window's: its template's star row
      hands the selected page an unconstrained height, BrowserTabPage's own star row collapses
      to whatever its content happens to want, and the WebView2 - faithfully filling a
      container that is itself wrong - paints the page into a band a few dozen pixels tall,
      full width. Overriding it here is the whole fix; nothing further down the tree can
      recover a height its ancestor never asked for.
    -->
    <TabView
      x:Name="TabStrip"
      Grid.Column="1"
      CanDragTabs="True"
      CanReorderTabs="True"
      IsAddTabButtonVisible="True"
      SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
      TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
      TabWidthMode="Equal"
      VerticalAlignment="Stretch"
      AddTabButtonClick="OnAddTabButtonClick"
      TabCloseRequested="OnTabCloseRequested">

      <!--  Left of the tabs: app mark, plus an InPrivate badge when this window is private.  -->
      <TabView.TabStripHeader>
        <StackPanel
          x:Name="TabStripHeaderPanel"
          Orientation="Horizontal"
          Padding="10,0,6,0"
          Spacing="8"
          VerticalAlignment="Center">
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="PrivateBadge"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate" />
          </Border>
        </StackPanel>
      </TabView.TabStripHeader>

      <!--  Right of the tabs: the window drag region. MinWidth keeps tabs clear of the caption buttons.  -->
      <TabView.TabStripFooter>
        <Grid
          x:Name="CustomDragRegion"
          Background="Transparent"
          MinWidth="188" />
      </TabView.TabStripFooter>

      <TabView.TabItemTemplate>
        <DataTemplate x:DataType="vm:BrowserTabViewModel">
          <!--
            No content alignment set here on purpose. TabViewItem's Horizontal/
            VerticalContentAlignment drive the *header* presenter in its own template - the
            title inside the tab chrome - and never reach Content, which TabView renders
            itself. Setting them to Stretch was tried against the band-height bug and only
            skewed the tab titles; the fix is TabView's VerticalAlignment above.
          -->
          <TabViewItem
            Header="{x:Bind Title, Mode=OneWay}"
            IconSource="{x:Bind TabIcon, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">

            <TabViewItem.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
              </MenuFlyout>
            </TabViewItem.ContextFlyout>

            <TabViewItem.Content>
              <views:BrowserTabPage ViewModel="{x:Bind}" />
            </TabViewItem.Content>
          </TabViewItem>
        </DataTemplate>
      </TabView.TabItemTemplate>
    </TabView>

    <!--
      Vertical tabs mode's stand-in for TabStripFooter: the drag region and caption-button
      clearance, since TabStrip's own footer is inside its (now hidden) native strip.

      An overlay (Top-aligned, Height set from code to match TabStripHeight), not a reserved
      Grid row: TabStrip has to keep its cell anchored at y=0 for the strip-hiding trick below
      to work at all, so there is no row left over here to occupy - "content starts at y=40"
      and "the native strip is fully off-screen above y=0" are not simultaneously satisfiable
      once TabStrip's own cell has been pushed down to y=40 by a reserved row, because the
      strip and the content it hides above are one contiguous block inside TabView's template.
      Overlaying instead of reserving space means this bar tints whatever content is directly
      under it rather than displacing it - the same trade Windows 11 itself makes when content
      scrolls under an extended, Mica-tinted title bar.
    -->
    <Grid
      x:Name="VerticalModeDragRegion"
      Grid.Column="1"
      VerticalAlignment="Top"
      Background="{ThemeResource WinserChromeBrush}"
      Visibility="{x:Bind ViewModel.VerticalTabsPaneVisibility, Mode=OneWay}" />

    <!--
      Vertical tabs mode's hover zone: a narrow, fully transparent strip down the left edge whose
      only job is to notice the pointer arriving and ask for the pane.

      The pane's actual chrome is deliberately not here. It lives in VerticalTabsOverlayWindow, a
      separate owned top-level window, because WebView2 is hosted in its default child-HWND mode
      (WebContentView.xaml.cs, CreateBrowserElement) and a child HWND paints over any XAML sibling
      in the same window regardless of z-order - so a pane rendered inline here was invisible the
      moment it overlapped the page, which is exactly what an overlay has to do. Keeping only this
      strip inline means VerticalTabsColumnDef never has to grow past the hover-zone width, so
      TabStrip's column - and the page inside it - never resizes when the pane opens or closes.
    -->
    <Grid
      x:Name="VerticalTabsPane"
      Grid.Column="0"
      Background="Transparent"
      Visibility="{x:Bind ViewModel.VerticalTabsPaneVisibility, Mode=OneWay}"
      PointerEntered="OnVerticalTabsPanePointerEntered"
      PointerExited="OnVerticalTabsPanePointerExited" />

  </Grid>
</Window>
