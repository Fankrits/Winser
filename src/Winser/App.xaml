<Application
  x:Class="Winser.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="using:Winser.Converters">

  <Application.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <!--  Browser chrome sits over Mica, so the chrome fills are translucent on purpose.  -->
          <SolidColorBrush x:Key="WinserChromeBrush" Color="#FFFFFF" Opacity="0.55" />
          <SolidColorBrush x:Key="WinserChromeBorderBrush" Color="#000000" Opacity="0.09" />
          <SolidColorBrush x:Key="WinserContentBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="WinserPrivateAccentBrush" Color="#4F46E5" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WinserChromeBrush" Color="#1C1C1C" Opacity="0.55" />
          <SolidColorBrush x:Key="WinserChromeBorderBrush" Color="#FFFFFF" Opacity="0.09" />
          <SolidColorBrush x:Key="WinserContentBackgroundBrush" Color="#202020" />
          <SolidColorBrush x:Key="WinserPrivateAccentBrush" Color="#4F46E5" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="WinserChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="WinserChromeBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="WinserContentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="WinserPrivateAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
      <conv:RelativeTimeConverter x:Key="RelativeTime" />

      <!--  A flat icon button for the toolbar; hover and pressed keep the system fills.  -->
      <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
      </Style>

      <!--  Bookmarks bar entries: icon and short label, no chrome until hovered.  -->
      <Style x:Key="BookmarkBarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
      </Style>

      <Style x:Key="PageHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>

      <!--  A row in a left-side ListView: the winser://settings sidebar, the vertical tab list.  -->
      <Style x:Key="SidebarListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>

      <!--
        The vertical tab list only: a soft translucent pill for the selected row instead of
        ListViewItem's default accent-colored left bar. Scoped to its own style rather than added
        to SidebarListItemStyle above, which winser://settings also uses and which keeps the
        default accent-bar look there.

        The override resources are nested ThemeDictionaries, not plain entries bound through
        StaticResource to a shared brush: StaticResource resolves once at parse time and would
        freeze the pill to whichever theme happened to be active then, where ThemeResource (what
        ListViewItem's own template uses internally to read these same keys) re-resolves on every
        theme change - so the override has to be theme-dictionary-shaped too, or it stops
        tracking light/dark after the first switch.
      -->
      <Style x:Key="VerticalTabItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource SidebarListItemStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Resources">
          <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
              <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFFFFF" Opacity="0.85" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFFFFF" Opacity="0.95" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFFFFF" Opacity="0.95" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
              </ResourceDictionary>
              <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFFFFF" Opacity="0.2" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFFFFF" Opacity="0.28" />
                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFFFFF" Opacity="0.28" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
              </ResourceDictionary>
              <!--  No HighContrast entry on purpose: ThemeResource keeps walking outward to the
                    framework's own defaults for a theme this dictionary doesn't cover, which
                    already satisfy high-contrast's own contrast rules - a translucent pill with
                    no guaranteed contrast against its background would not.  -->
            </ResourceDictionary.ThemeDictionaries>
          </ResourceDictionary>
        </Setter>
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
