<UserControl
  x:Class="Winser.Controls.BrowserSiteInfoButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button
    AutomationProperties.Name="Site information"
    Content="{x:Bind Tab.SecurityGlyph, Mode=OneWay}"
    Style="{StaticResource ToolbarIconButtonStyle}"
    ToolTipService.ToolTip="{x:Bind Tab.SecurityTooltip, Mode=OneWay}">
    <Button.Flyout>
      <Flyout>
        <StackPanel MaxWidth="320" Spacing="6">
          <TextBlock
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind Tab.HostLabel, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock Opacity="0.8" Text="{x:Bind Tab.SecurityTooltip, Mode=OneWay}" TextWrapping="Wrap" />
          <TextBlock
            FontFamily="Consolas"
            FontSize="12"
            Opacity="0.6"
            Text="{x:Bind Tab.Url, Mode=OneWay}"
            TextWrapping="Wrap" />
          <Button Margin="0,4,0,0" Command="{x:Bind Tab.CopyLinkCommand}" Content="Copy address" />
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
