<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Winser</RootNamespace>
    <AssemblyName>Winser</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Winser.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!--
      MVVMTK0045: [ObservableProperty] on a field is flagged as not AOT-safe in WinRT scenarios;
      the suggested fix is a partial property, which needs C# 13 and so a net9.0+ target. Winser
      targets net8.0 and is not published AOT, so the fields stay and the notice is muted.
    -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>

    <!--
      Winser ships as an unpackaged (plain .exe) desktop app so it can be xcopy-deployed
      and launched without an MSIX identity. Self-containing the Windows App SDK removes
      the "install the WindowsAppRuntime first" step for end users.
      Flip WindowsAppSDKSelfContained/SelfContained to false for a much smaller output
      that requires the Windows App SDK runtime to be installed on the machine.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>

    <!--
      Without this, `dotnet build` fails with MSB4062 trying to load
      Microsoft.Build.Packaging.Pri.Tasks.ExpandPriContent - that PRI/MRT resource-indexing task
      normally ships only with Visual Studio's MSBuild, not the .NET SDK's (a known, unresolved
      WindowsAppSDK gap: see issues #3939, #4889, #3548). Confirmed fixed for this project's
      unpackaged (WindowsPackageType=None) shape by CI's dotnet-build job in
      .github/workflows/build.yml, which builds with plain `dotnet build` on every push.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- A self-contained app always needs a RID; derive it from the selected VS platform. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Microsoft.Web.WebView2 comes in transitively with the Windows App SDK, which
         pins the loader version its WebView2 XAML control expects. Do not pin it here. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
  </ItemGroup>

</Project>
