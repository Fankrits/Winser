<UserControl
  x:Class="Winser.Controls.BrowserMenuButton"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Button
    AutomationProperties.Name="Settings and more"
    Content="&#xE712;"
    Style="{StaticResource ToolbarIconButtonStyle}"
    ToolTipService.ToolTip="Settings and more">
    <Button.Flyout>
      <MenuFlyout Placement="BottomEdgeAlignedRight">
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.AddTabCommand}" KeyboardAcceleratorTextOverride="Ctrl+T" Text="New tab">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.NewWindowCommand}" KeyboardAcceleratorTextOverride="Ctrl+N" Text="New window" />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.NewPrivateWindowCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+N" Text="New InPrivate window">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE727;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Command="{x:Bind Tab.GoForwardCommand}" KeyboardAcceleratorTextOverride="Alt+Right" Text="Forward" />
        <MenuFlyoutItem Command="{x:Bind Tab.GoHomeCommand}" KeyboardAcceleratorTextOverride="Alt+Home" Text="Home" />
        <MenuFlyoutItem
          Command="{x:Bind Tab.ToggleBookmarkCommand}"
          KeyboardAcceleratorTextOverride="Ctrl+D"
          Text="{x:Bind Tab.BookmarkTooltip, Mode=OneWay}" />
        <MenuFlyoutItem
          Command="{x:Bind Tab.ToggleMuteCommand}"
          Text="{x:Bind Tab.MuteTooltip, Mode=OneWay}"
          Visibility="{x:Bind Tab.IsAudioPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        <MenuFlyoutItem
          Command="{x:Bind Tab.Shell.ToggleVerticalTabsPinnedCommand}"
          Text="{x:Bind Tab.Shell.PinTooltip, Mode=OneWay}"
          Visibility="{x:Bind Tab.Shell.UseVerticalTabs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Command="{x:Bind Tab.ZoomInCommand}" KeyboardAcceleratorTextOverride="Ctrl++" Text="Zoom in" />
        <MenuFlyoutItem Command="{x:Bind Tab.ZoomOutCommand}" KeyboardAcceleratorTextOverride="Ctrl+-" Text="Zoom out" />
        <MenuFlyoutItem Command="{x:Bind Tab.ResetZoomCommand}" Text="{x:Bind Tab.ZoomLabel, Mode=OneWay}" />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.ToggleFullScreenCommand}" KeyboardAcceleratorTextOverride="F11" Text="Full screen" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Command="{x:Bind Tab.OpenFindCommand}" KeyboardAcceleratorTextOverride="Ctrl+F" Text="Find on page" />
        <MenuFlyoutItem Command="{x:Bind Tab.PrintCommand}" KeyboardAcceleratorTextOverride="Ctrl+P" Text="Print" />
        <MenuFlyoutItem Command="{x:Bind Tab.CopyLinkCommand}" Text="Copy page address" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.OpenBookmarksCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+O" Text="Bookmarks" />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.OpenHistoryCommand}" KeyboardAcceleratorTextOverride="Ctrl+H" Text="History" />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.OpenDownloadsCommand}" KeyboardAcceleratorTextOverride="Ctrl+J" Text="Downloads" />
        <ToggleMenuFlyoutItem
          Command="{x:Bind Tab.Shell.ToggleBookmarksBarCommand}"
          IsChecked="{x:Bind Tab.Shell.ShowBookmarksBar, Mode=OneWay}"
          KeyboardAcceleratorTextOverride="Ctrl+Shift+B"
          Text="Show bookmarks bar" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Command="{x:Bind Tab.OpenDevToolsCommand}" KeyboardAcceleratorTextOverride="F12" Text="Developer tools" />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.OpenSettingsCommand}" Text="Settings">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Command="{x:Bind Tab.Shell.CloseWindowCommand}" Text="Close window" />
      </MenuFlyout>
    </Button.Flyout>
  </Button>
</UserControl>
