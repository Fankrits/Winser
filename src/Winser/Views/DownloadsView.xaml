<UserControl
  x:Class="Winser.Views.DownloadsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <Grid Background="{ThemeResource WinserContentBackgroundBrush}" Padding="32,28,32,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Downloads" />
        <TextBlock Opacity="0.65" Text="Files Winser has saved from the web." />
      </StackPanel>
      <Button
        Grid.Column="1"
        Click="OnOpenFolder"
        Content="Open downloads folder"
        VerticalAlignment="Bottom" />
      <Button
        Grid.Column="2"
        Click="OnClearList"
        Content="Clear list"
        VerticalAlignment="Bottom" />
    </Grid>

    <TextBlock
      Grid.Row="1"
      Margin="0,32,0,0"
      HorizontalAlignment="Center"
      Opacity="0.6"
      Text="Nothing downloaded yet."
      Visibility="{x:Bind Items.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibility}, ConverterParameter=Invert}" />

    <ListView
      Grid.Row="1"
      ItemsSource="{x:Bind Items, Mode=OneWay}"
      SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:DownloadItem">
          <Grid Padding="0,10" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
              FontSize="20"
              Glyph="&#xE8E5;"
              Opacity="0.6"
              VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
              <ProgressBar
                Maximum="100"
                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                Value="{x:Bind ProgressPercent, Mode=OneWay}"
                Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                  Opacity="0.6"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="{x:Bind StatusText, Mode=OneWay}" />
                <TextBlock Opacity="0.35" Style="{StaticResource CaptionTextBlockStyle}" Text="&#x2022;" />
                <TextBlock
                  Opacity="0.6"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Text="{x:Bind SourceHost}" />
              </StackPanel>
            </StackPanel>

            <StackPanel
              Grid.Column="2"
              Orientation="Horizontal"
              Spacing="2"
              VerticalAlignment="Center">
              <Button
                Command="{x:Bind TogglePauseCommand}"
                Content="&#xE769;"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTipService.ToolTip="Pause or resume"
                Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
              <Button
                Command="{x:Bind CancelCommand}"
                Content="&#xE711;"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTipService.ToolTip="Cancel"
                Visibility="{x:Bind IsInProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
              <Button
                Command="{x:Bind OpenCommand}"
                Content="&#xE8E5;"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTipService.ToolTip="Open file"
                Visibility="{x:Bind IsCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
              <Button
                Command="{x:Bind ShowInFolderCommand}"
                Content="&#xE8B7;"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTipService.ToolTip="Show in folder" />
              <Button
                Click="OnRemoveItem"
                Content="&#xE74D;"
                Style="{StaticResource ToolbarIconButtonStyle}"
                ToolTipService.ToolTip="Remove from list" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
