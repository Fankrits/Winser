<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Winser</RootNamespace>
    <AssemblyName>Winser</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Winser.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!--
      Winser ships as an unpackaged (plain .exe) desktop app so it can be xcopy-deployed
      and launched without an MSIX identity. Self-containing the Windows App SDK removes
      the "install the WindowsAppRuntime first" step for end users.
      Flip WindowsAppSDKSelfContained/SelfContained to false for a much smaller output
      that requires the Windows App SDK runtime to be installed on the machine.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!--
      Precompiled native code instead of JIT on first use. It costs disk, and pays for itself
      twice at run time: the app starts without compiling itself first, and the code it runs
      is mapped from the file rather than JIT-written into private, dirty pages. Applies to
      `dotnet publish` only - a plain `dotnet build` still produces IL.
    -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>

    <!--
      The Windows App SDK carries translated resources for around forty languages. Winser's
      own UI is English, so every one of those satellite assemblies is dead weight in the
      output. (This drops the .NET/WinAppSDK satellite assemblies only - Windows' own language
      handling, and pages, are untouched.)
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Without this, `dotnet build` fails with MSB4062 trying to load
      Microsoft.Build.Packaging.Pri.Tasks.ExpandPriContent - that PRI/MRT resource-indexing task
      normally ships only with Visual Studio's MSBuild, not the .NET SDK's (a known, unresolved
      WindowsAppSDK gap: see issues #3939, #4889, #3548). Confirmed fixed for this project's
      unpackaged (WindowsPackageType=None) shape by CI's dotnet-build job in
      .github/workflows/build.yml, which builds with plain `dotnet build` on every push.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- A self-contained app always needs a RID; derive it from the selected VS platform. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Microsoft.Web.WebView2 comes in transitively with the Windows App SDK, which
         pins the loader version its WebView2 XAML control expects. Do not pin it here. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />

    <!--
      The Microsoft.WindowsAppSDK meta-package pulls in nine sub-packages; Winser needs five
      of them. The other four - AI, ML, Search, Widgets - added ~60 MB self-contained (mostly
      onnxruntime.dll and DirectML.dll, neither of which Winser's code ever touches) for
      on-device AI features and OS search integration nothing here uses. Checked each of these
      five sub-packages' own dependency lists first: none of them reaches back into AI, ML,
      Search or Widgets, so this is not fighting a transitive pull - the unused weight was
      coming from the meta-package's own top-level dependency list, nothing deeper.
      Runtime is kept: unlike the meta-package (whose own build/buildTransitive targets are
      empty, just two ProjectCapability markers), Runtime's targets set up the AppX/component
      references WindowsAppSDKSelfContained relies on to bundle the native runtime.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
  </ItemGroup>

</Project>
