<Window
  x:Class="Winser.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="using:Winser.Views"
  xmlns:vm="using:Winser.ViewModels"
  mc:Ignorable="d">

  <!--
    Disabled from 29d266f to c66e231 while chasing a WebView2 rendering bug: on at least one
    real (non-VM) machine, WebView2 rendered nothing at all - not even the New Tab page - and
    no amount of resizing or switching tabs recovered it. That symptom is now explained without
    Mica - f69ce7d and ffa2811 each fixed a way the browser element could be created against a
    collapsed or zero-size container, which is exactly "blank, and permanently so" - so Mica was
    never actually the culprit, just a variable removed at the same time by coincidence of
    timing. Restored now that the real cause (TabView's default VerticalAlignment="Top", fixed
    in c66e231) is confirmed on a real machine. If it turns out to still conflict with WebView2
    on some hardware, revert this one commit - nothing else depends on it being on.
  -->
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!--
    Transparent, not unset: lets Mica show through while keeping the whole window hit-testable.

    Column 0 exists for vertical tabs mode only: a pane on the left standing in for the
    horizontal strip. It is sized to zero and collapses to nothing when vertical tabs are off,
    which is also the default - so nothing here changes horizontal mode's geometry. When vertical
    tabs is on, this column is always just wide enough for VerticalTabsPane's own hover-detection
    strip (VerticalTabsHoverZoneWidth) - constant regardless of whether the pane is expanded -
    because the pane overlays wider than its own column when expanded rather than the column
    growing to fit it, which is what keeps TabStrip's content from ever resizing as the pane
    opens and closes (see VerticalTabsPane's own comment below). TabStrip's own Grid.Column never
    changes between modes and it deliberately has no Grid.Row at all - its cell must stay
    anchored at y=0 in both modes, since that is what lets a negative top margin (see
    MainWindow.xaml.cs, UpdateChromeLayout) push the native strip fully off-screen above the
    window rather than just far enough to clear a reserved row; the vertical mode drag region is
    a same-origin overlay, not a second row, for the same y=0 reason - see its own comment below.
  -->
  <Grid x:Name="RootGrid" Background="Transparent">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="VerticalTabsColumnDef" Width="0" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!--
      VerticalAlignment is load-bearing, not cosmetic. TabView's own default style sets
      VerticalAlignment="Top" (DefaultTabViewStyle, microsoft-ui-xaml
      controls/dev/TabView/TabView.xaml), which suits a tab strip pinned above something else
      but is wrong for a browser, where the tab *is* the window. Left at the default, TabView
      is arranged at its desired height rather than the window's: its template's star row
      hands the selected page an unconstrained height, BrowserTabPage's own star row collapses
      to whatever its content happens to want, and the WebView2 - faithfully filling a
      container that is itself wrong - paints the page into a band a few dozen pixels tall,
      full width. Overriding it here is the whole fix; nothing further down the tree can
      recover a height its ancestor never asked for.
    -->
    <TabView
      x:Name="TabStrip"
      Grid.Column="1"
      CanDragTabs="True"
      CanReorderTabs="True"
      IsAddTabButtonVisible="True"
      SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
      TabItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
      TabWidthMode="Equal"
      VerticalAlignment="Stretch"
      AddTabButtonClick="OnAddTabButtonClick"
      TabCloseRequested="OnTabCloseRequested">

      <!--  Left of the tabs: app mark, plus an InPrivate badge when this window is private.  -->
      <TabView.TabStripHeader>
        <StackPanel
          x:Name="TabStripHeaderPanel"
          Orientation="Horizontal"
          Padding="10,0,6,0"
          Spacing="8"
          VerticalAlignment="Center">
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="PrivateBadge"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate" />
          </Border>
        </StackPanel>
      </TabView.TabStripHeader>

      <!--  Right of the tabs: the window drag region. MinWidth keeps tabs clear of the caption buttons.  -->
      <TabView.TabStripFooter>
        <Grid
          x:Name="CustomDragRegion"
          Background="Transparent"
          MinWidth="188" />
      </TabView.TabStripFooter>

      <TabView.TabItemTemplate>
        <DataTemplate x:DataType="vm:BrowserTabViewModel">
          <!--
            No content alignment set here on purpose. TabViewItem's Horizontal/
            VerticalContentAlignment drive the *header* presenter in its own template - the
            title inside the tab chrome - and never reach Content, which TabView renders
            itself. Setting them to Stretch was tried against the band-height bug and only
            skewed the tab titles; the fix is TabView's VerticalAlignment above.
          -->
          <TabViewItem
            Header="{x:Bind Title, Mode=OneWay}"
            IconSource="{x:Bind TabIcon, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">

            <TabViewItem.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
              </MenuFlyout>
            </TabViewItem.ContextFlyout>

            <TabViewItem.Content>
              <views:BrowserTabPage ViewModel="{x:Bind}" />
            </TabViewItem.Content>
          </TabViewItem>
        </DataTemplate>
      </TabView.TabItemTemplate>
    </TabView>

    <!--
      Vertical tabs mode's stand-in for TabStripFooter: the drag region and caption-button
      clearance, since TabStrip's own footer is inside its (now hidden) native strip.

      An overlay (Top-aligned, Height set from code to match TabStripHeight), not a reserved
      Grid row: TabStrip has to keep its cell anchored at y=0 for the strip-hiding trick below
      to work at all, so there is no row left over here to occupy - "content starts at y=40"
      and "the native strip is fully off-screen above y=0" are not simultaneously satisfiable
      once TabStrip's own cell has been pushed down to y=40 by a reserved row, because the
      strip and the content it hides above are one contiguous block inside TabView's template.
      Overlaying instead of reserving space means this bar tints whatever content is directly
      under it rather than displacing it - the same trade Windows 11 itself makes when content
      scrolls under an extended, Mica-tinted title bar.
    -->
    <Grid
      x:Name="VerticalModeDragRegion"
      Grid.Column="1"
      VerticalAlignment="Top"
      Background="{ThemeResource WinserChromeBrush}"
      Visibility="{x:Bind ViewModel.VerticalTabsPaneVisibility, Mode=OneWay}" />

    <!--
      Vertical tabs mode's stand-in for the whole native strip.

      This outer Grid is the one continuous hit-test surface for the whole collapsed/expanded
      lifecycle - it is never replaced by a second, different element - specifically so a hover
      hand-off between two overlapping elements is not a scenario that can ever arise. Its own
      Width is set from code (VerticalTabsExpandedWidth or VerticalTabsHoverZoneWidth), not the
      column's: VerticalTabsColumnDef only ever reserves the tiny hover-zone width whenever
      vertical tabs is on, constant regardless of expanded state, so TabStrip's content never
      resizes or reflows as the pane opens and closes. Expanding therefore means this Grid
      renders wider than its own column and bleeds into TabStrip's column instead - the same
      "Grid does not clip a child to its cell" behavior the strip-hiding trick above already
      relies on - which is what makes it a true floating overlay rather than a resize. Background
      is Transparent so the collapsed hover-zone shows nothing at all, not even a thin rail; the
      actual visible chrome lives in the child Border below, shown only once truly expanded.
    -->
    <Grid
      x:Name="VerticalTabsPane"
      Grid.Column="0"
      HorizontalAlignment="Left"
      Background="Transparent"
      Visibility="{x:Bind ViewModel.VerticalTabsPaneVisibility, Mode=OneWay}"
      PointerEntered="OnVerticalTabsPanePointerEntered"
      PointerExited="OnVerticalTabsPanePointerExited">
      <Border
        Background="{ThemeResource WinserChromeBrush}"
        BorderBrush="{ThemeResource WinserChromeBorderBrush}"
        BorderThickness="0,0,1,0"
        Visibility="{x:Bind ViewModel.VerticalTabsPaneExpandedVisibility, Mode=OneWay}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  App mark, InPrivate badge, and the pin toggle - the pane's own header, matching
              TabStripHeader/TabStripFooter's job in horizontal mode.  -->
        <Grid
          Grid.Row="0"
          Height="40"
          Padding="12,0,6,0"
          ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image
            Width="16"
            Height="16"
            Source="ms-appx:///Assets/Winser.png"
            VerticalAlignment="Center" />
          <Border
            x:Name="VerticalPrivateBadge"
            Grid.Column="1"
            Padding="8,2"
            Background="{ThemeResource WinserPrivateAccentBrush}"
            CornerRadius="10"
            Visibility="Collapsed"
            VerticalAlignment="Center">
            <TextBlock
              FontSize="11"
              FontWeight="SemiBold"
              Foreground="White"
              Text="InPrivate"
              Visibility="{x:Bind ViewModel.VerticalTabsExpandedVisibility, Mode=OneWay}" />
          </Border>
          <Button
            Grid.Column="3"
            Command="{x:Bind ViewModel.ToggleVerticalTabsPinnedCommand}"
            Content="{x:Bind ViewModel.PinGlyph, Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.PinTooltip, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.VerticalTabsExpandedVisibility, Mode=OneWay}" />
        </Grid>

        <!--  Nav buttons and address bar, standing in for BrowserTabPage's own toolbar (hidden
              while vertical tabs is on, see BrowserViewModel.IsToolbarVisible) - both act on
              whichever tab is currently selected, so every binding here is explicitly OneWay:
              SelectedTab changes as the user switches tabs, unlike BrowserTabPage's own ViewModel,
              which is fixed to one tab for that page's whole lifetime.  -->
        <Grid
          Grid.Row="1"
          Margin="8,4,8,0"
          ColumnSpacing="2"
          Visibility="{x:Bind ViewModel.VerticalTabsExpandedVisibility, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button
            Grid.Column="0"
            AutomationProperties.Name="Back"
            Command="{x:Bind ViewModel.SelectedTab.GoBackCommand, Mode=OneWay}"
            Content="&#xE72B;"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="Back (Alt+Left)" />
          <Button
            Grid.Column="1"
            AutomationProperties.Name="Forward"
            Command="{x:Bind ViewModel.SelectedTab.GoForwardCommand, Mode=OneWay}"
            Content="&#xE72A;"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="Forward (Alt+Right)" />
          <Button
            Grid.Column="2"
            AutomationProperties.Name="Reload"
            Command="{x:Bind ViewModel.SelectedTab.ReloadOrStopCommand, Mode=OneWay}"
            Content="{x:Bind ViewModel.SelectedTab.ReloadGlyph, Mode=OneWay}"
            Style="{StaticResource ToolbarIconButtonStyle}"
            ToolTipService.ToolTip="{x:Bind ViewModel.SelectedTab.ReloadTooltip, Mode=OneWay}" />
        </Grid>

        <AutoSuggestBox
          x:Name="VerticalAddressBox"
          Grid.Row="2"
          Height="32"
          Margin="8,4"
          CornerRadius="16"
          ItemsSource="{x:Bind ViewModel.SelectedTab.Suggestions, Mode=OneWay}"
          PlaceholderText="Search or enter web address"
          Text="{x:Bind ViewModel.SelectedTab.AddressText, Mode=OneWay}"
          TextMemberPath="Text"
          Visibility="{x:Bind ViewModel.VerticalTabsExpandedVisibility, Mode=OneWay}"
          GotFocus="OnVerticalAddressGotFocus"
          LostFocus="OnVerticalAddressLostFocus"
          QuerySubmitted="OnVerticalAddressQuerySubmitted"
          TextChanged="OnVerticalAddressTextChanged">
          <AutoSuggestBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AddressSuggestion">
              <Grid Padding="0,3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                  FontSize="14"
                  Glyph="{x:Bind Glyph}"
                  Opacity="0.65"
                  VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Description}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </AutoSuggestBox.ItemTemplate>
        </AutoSuggestBox>

        <Button
          Grid.Row="3"
          Margin="8,2,8,6"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Left"
          Background="Transparent"
          BorderThickness="0"
          Command="{x:Bind ViewModel.AddTabCommand}"
          ToolTipService.ToolTip="New tab (Ctrl+T)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon FontSize="14" Glyph="&#xE710;" Opacity="0.85" />
            <TextBlock Text="New tab" Visibility="{x:Bind ViewModel.VerticalTabsExpandedVisibility, Mode=OneWay}" />
          </StackPanel>
        </Button>

        <ListView
          x:Name="VerticalTabList"
          Grid.Row="4"
          Padding="6,0,6,6"
          AllowDrop="True"
          CanReorderItems="True"
          ItemContainerStyle="{StaticResource SidebarListItemStyle}"
          ItemsSource="{x:Bind ViewModel.Tabs, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
          SelectionChanged="OnVerticalTabSelectionChanged"
          SelectionMode="Single">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:BrowserTabViewModel">
              <Grid ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind DuplicateCommand}" Text="Duplicate tab" />
                    <MenuFlyoutItem Command="{x:Bind ReloadOrStopCommand}" Text="Reload" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind CloseOthersCommand}" Text="Close other tabs" />
                    <MenuFlyoutItem Command="{x:Bind CloseToTheRightCommand}" Text="Close tabs to the right" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind CloseCommand}" Text="Close tab" />
                  </MenuFlyout>
                </Grid.ContextFlyout>

                <IconSourceElement
                  Width="16"
                  Height="16"
                  IconSource="{x:Bind TabIcon, Mode=OneWay}"
                  VerticalAlignment="Center" />
                <TextBlock
                  Grid.Column="1"
                  Text="{x:Bind Title, Mode=OneWay}"
                  TextTrimming="CharacterEllipsis"
                  VerticalAlignment="Center"
                  Visibility="{x:Bind Shell.VerticalTabsExpandedVisibility, Mode=OneWay}" />
                <Button
                  Grid.Column="2"
                  Command="{x:Bind CloseCommand}"
                  Content="&#xE711;"
                  Style="{StaticResource ToolbarIconButtonStyle}"
                  ToolTipService.ToolTip="Close tab"
                  Visibility="{x:Bind Shell.VerticalTabsExpandedVisibility, Mode=OneWay}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
