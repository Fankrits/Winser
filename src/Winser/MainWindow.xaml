                      <FontIcon Glyph="&#xE710;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.NewWindowCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+N"
                    Text="New window" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.NewPrivateWindowCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+N"
                    Text="New InPrivate window">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE727;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>

                  <MenuFlyoutSeparator />

                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.ZoomInCommand, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Ctrl++"
                    Text="Zoom in" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.ZoomOutCommand, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Ctrl+-"
                    Text="Zoom out" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.ResetZoomCommand, Mode=OneWay}"
                    Text="{x:Bind ViewModel.SelectedTab.ZoomLabel, Mode=OneWay}" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    KeyboardAcceleratorTextOverride="F11"
                    Text="Full screen" />

                  <MenuFlyoutSeparator />

                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.OpenFindCommand, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Ctrl+F"
                    Text="Find on page" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.PrintCommand, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Ctrl+P"
                    Text="Print" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.CopyLinkCommand, Mode=OneWay}"
                    Text="Copy page address" />

                  <MenuFlyoutSeparator />

                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenBookmarksCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+O"
                    Text="Bookmarks" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenHistoryCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+H"
                    Text="History" />
                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.OpenDownloadsCommand}"
                    KeyboardAcceleratorTextOverride="Ctrl+J"
                    Text="Downloads" />

                  <MenuFlyoutSeparator />

                  <MenuFlyoutItem
                    Command="{x:Bind ViewModel.SelectedTab.OpenDevToolsCommand, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="F12"
                    Text="Developer tools" />
                  <MenuFlyoutItem Command="{x:Bind ViewModel.OpenSettingsCommand}" Text="Settings">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>

                  <MenuFlyoutSeparator />

                  <MenuFlyoutItem Command="{x:Bind ViewModel.CloseWindowCommand}" Text="Close window" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>
      </Grid>
      </Border>
      </Grid>
    </Popup>

  </Grid>
